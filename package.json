{
  "name": "nibrass",
  "version": "1.0.0",
  "description": "Apprendre l'anglais avec ta playlist Apple Music : interprétation des chansons, cours de grammaire, vocabulaire et quiz quotidien.",
  "type": "module",
  "main": "server/index.js",
  "scripts": {
    "start": "node server/index.js",
    "dev": "node --watch server/index.js",
