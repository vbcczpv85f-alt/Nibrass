  },
  "license": "MIT",
  "dependencies": {
    "@anthropic-ai/sdk": "^1.5.0",
    "dotenv": "^18.0.9",
    "express": "^5.3.0",
    "jsonwebtoken": "^9.0.3"
  },
  "devDependencies": {
    "esbuild": "^0.24.2"
  }
}
