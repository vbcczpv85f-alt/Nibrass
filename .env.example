# Clé API Claude (https://console.anthropic.com) — active les leçons et les quiz IA
ANTHROPIC_API_KEY=

# Optionnel : mot de passe pour protéger l'app si elle est en ligne
APP_PASSWORD=

# Optionnel : pays du catalogue Apple Music (fr, be, ca, ch…)
APPLE_STOREFRONT=fr

# Optionnel : connexion directe à Apple Music (compte Apple Developer requis)
APPLE_TEAM_ID=
APPLE_KEY_ID=
APPLE_PRIVATE_KEY_PATH=./AuthKey_XXXXXXXXXX.p8

# Optionnel
PORT=3000
TZ=Europe/Paris
